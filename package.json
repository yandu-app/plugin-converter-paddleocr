{
  "name": "@yandu/plugin-converter-paddleocr",
  "version": "1.0.0",
  "description": "Yandu PDF converter plugin using PaddleOCR",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "test": "npm run build && node --test test/*.test.js",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "prepack": "npm run test"
  },
  "dependencies": {
    "@yandu/types": ">=0.0.7 <0.2"
  },
  "devDependencies": {
    "@types/node": "^25.6.2",
    "typescript": "^5.6.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "yandu-converter-paddleocr": "./dist/worker.js"
  },
  "yandu": {
    "worker": "./dist/worker.js",
    "protocol": "jsonl-v1"
  }
}
